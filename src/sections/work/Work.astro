---
import Divider from '../../components/divider/Divider.astro';
---

<section class="section">
  <div class="grid-container">
    <div class="col-span-4">
      <h2 class="text-black">Work</h2>
    </div>
    <div class="col-span-8">
      <div class="col-8-grid">
        <div class="col-span-2">
          <p class="text-black">2022—Now</p>
        </div>
        <div class="col-span-6">
          <div>
            <p class="text-black">Vieu</p>
            <p>Senior Software Engineer</p>
            <p>
              Architected and shipped Vieu, a data-driven platform, from 0 to 1.
              Built the core product architecture, implemented most of the
              feature set, and led the platform to market. Contributed to the
              company's seed funding round by delivering a production-ready MVP.
            </p>
          </div>
        </div>
        <div class="col-span-2">
          <p class="text-black">2020-2022</p>
        </div>
        <div class="col-span-6">
          <div>
            <p class="text-black">Envestnet</p>
            <p>Senior UI Engineer</p>
            <p>
              Owned UI implementation for Envestnet's flagship proposal system.
              Built out several features and drove significant performance
              gains. Mentored junior engineers and helped setting up a team in
              US
            </p>
          </div>
        </div>
        <div class="col-span-2">
          <p class="text-black">2018-2020</p>
        </div>
        <div class="col-span-6">
          <div>
            <p class="text-black">Clevero</p>
            <p>Full stack engineer</p>
            <p>
              Part of a lean team that built an end-to-end HR management
              platform for small to mid-sized businesses using React and
              Node.js.
            </p>
          </div>
        </div>
      </div>
      <Divider />
    </div>
  </div>
</section>
