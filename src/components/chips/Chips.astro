---
interface Props {
  content: string;
}
const { content } = Astro.props;
---

<div class="chip">
  <p>{content}</p>
</div>

<style>
  .chip {
    background-color: var(--second-color);
    display: inline-block;
    border-radius: 50px;
    padding: 5px 10px;
    margin: 0 8px 8px 0;
  }

  .chip p {
    line-height: 2px;
    margin: 3px;
    padding: 3px;
    font-size: 1rem;
  }
</style>
